@model IEnumerable<IdentityUser>


<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="#">Edit</a>
                    <a class="btn btn-sm btn-danger" href="#">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>